[
	// Ctrl+wheel zoom of the Default package. Mouse bindings have no context, so the command
	// runs ST's own zoom outside target views.
	{ "button": "scroll_down", "modifiers": ["ctrl"], "command": "mdgh_preview_zoom", "args": { "step": -1 } },
	{ "button": "scroll_up", "modifiers": ["ctrl"], "command": "mdgh_preview_zoom", "args": { "step": 1 } }
]
